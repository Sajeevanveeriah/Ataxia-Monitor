Version 4
SHEET 1 2400 1400
TEXT -400 -400 Left 3 ;SIM04a VW-MTC1 Hall front end, one channel (schematic version of sim04a_hall_afe_ac.cir)
TEXT -400 -360 Left 2 ;SS49E modelled as 1.65 V + AC 1 V behind 100 ohm. R50 1 M pull-down, Sallen-Key LPF R51 = R52 = 10 k, C51 100 nF, C52 47 nF
TEXT -400 -330 Left 2 ;U6 = MCP6004 class via UniversalOpAmp2 (GBW 1 MHz, 0.6 V/us, Avol 4e5, rail-to-rail). Expected fc 232 Hz, Q 0.73
SYMBOL voltage -360 -100 R0
SYMATTR InstName Vs
SYMATTR Value DC 1.65 AC 1
WIRE -360 -84 -360 -100
FLAG -360 -100 hs
WIRE -360 -4 -360 12
FLAG -360 12 0
SYMBOL res -240 -100 R0
SYMATTR InstName Rsens
SYMATTR Value 100
WIRE -224 -84 -224 -100
FLAG -224 -100 hs
WIRE -224 -4 -224 12
FLAG -224 12 hall
SYMBOL res -120 -100 R0
SYMATTR InstName R50
SYMATTR Value 1Meg
WIRE -104 -84 -104 -100
FLAG -104 -100 hall
WIRE -104 -4 -104 12
FLAG -104 12 0
SYMBOL res 0 -100 R0
SYMATTR InstName R51
SYMATTR Value 10k
WIRE 16 -84 16 -100
FLAG 16 -100 hall
WIRE 16 -4 16 12
FLAG 16 12 n1
SYMBOL res 120 -100 R0
SYMATTR InstName R52
SYMATTR Value 10k
WIRE 136 -84 136 -100
FLAG 136 -100 n1
WIRE 136 -4 136 12
FLAG 136 12 n2
SYMBOL cap 240 -84 R0
SYMATTR InstName C51
SYMATTR Value 100n
WIRE 256 -84 256 -100
FLAG 256 -100 n1
WIRE 256 -20 256 -4
FLAG 256 -4 adc
SYMBOL cap 360 -84 R0
SYMATTR InstName C52
SYMATTR Value 47n
WIRE 376 -84 376 -100
FLAG 376 -100 n2
WIRE 376 -20 376 -4
FLAG 376 -4 0
SYMBOL OpAmps\UniversalOpAmp2 560 0 R0
SYMATTR InstName U6
SYMATTR Value2 Avol=4e5 GBW=1Meg Slew=0.6Meg
SYMATTR SpiceLine Ilimit=15m Rail=25m Vos=0
SYMATTR SpiceLine2 En=0 Enk=0 In=0 Ink=0 Rin=500Meg
FLAG 528 16 n2
FLAG 528 -16 adc
FLAG 560 -32 vdd
FLAG 560 32 0
FLAG 592 0 adc
SYMBOL voltage 760 -100 R0
SYMATTR InstName Vdd
SYMATTR Value 3.3
WIRE 760 -84 760 -100
FLAG 760 -100 vdd
WIRE 760 -4 760 12
FLAG 760 12 0
TEXT -400 200 Left 2 !.ac dec 200 1 10Meg
TEXT -400 230 Left 2 !.meas AC f3db WHEN mag(V(adc))=0.70711 FALL=1
TEXT -400 260 Left 2 !.meas AC g1k FIND mag(V(adc)) AT 1k
